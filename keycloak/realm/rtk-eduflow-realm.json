{
  "realm": "rtk-eduflow",
  "enabled": true,
  "displayName": "RTK EduFlow",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "rtk-eduflow-frontend",
      "name": "RTK EduFlow Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:5174",
        "http://127.0.0.1:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "rtk-eduflow-backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rtk-eduflow-backend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "rtk-eduflow-backend",
      "name": "RTK EduFlow Backend",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret"
    }
  ],
  "roles": {
    "client": {
      "rtk-eduflow-backend": [
        {
          "name": "KAM",
          "description": "University account manager"
        },
        {
          "name": "MANAGER",
          "description": "Manager lead"
        },
        {
          "name": "ADMIN",
          "description": "Platform administrator"
        }
      ]
    }
  },
  "users": [
    {
      "username": "kam1",
      "enabled": true,
      "email": "kam1@example.local",
      "firstName": "KAM",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "kam1",
          "temporary": false
        }
      ],
      "clientRoles": {
        "rtk-eduflow-backend": ["KAM"]
      }
    },
    {
      "username": "manager1",
      "enabled": true,
      "email": "manager1@example.local",
      "firstName": "Manager",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "manager1",
          "temporary": false
        }
      ],
      "clientRoles": {
        "rtk-eduflow-backend": ["MANAGER"]
      }
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin1",
          "temporary": false
        }
      ],
      "clientRoles": {
        "rtk-eduflow-backend": ["ADMIN"]
      }
    },
    {
      "username": "viewer1",
      "enabled": true,
      "email": "viewer1@example.local",
      "firstName": "Viewer",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "viewer1",
          "temporary": false
        }
      ]
    }
  ]
}
