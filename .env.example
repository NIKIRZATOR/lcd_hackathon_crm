COMPOSE_PROJECT_NAME=rtk-eduflow
APP_NAME=edu_crm

# Core
POSTGRES_DB=rtk_eduflow
POSTGRES_USER=rtk_eduflow
POSTGRES_PASSWORD=rtk_eduflow
KEYCLOAK_DB=keycloak

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=rtk-eduflow
KEYCLOAK_FRONTEND_CLIENT_ID=rtk-eduflow-frontend
KEYCLOAK_BACKEND_CLIENT_ID=rtk-eduflow-backend
KEYCLOAK_AUDIENCE=rtk-eduflow-backend
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Backend scaling (safe defaults for a developer workstation)
BACKEND_REPLICAS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
ENABLE_DIAGNOSTIC_HEADERS=false

# Load balancer (used by docker-compose.demo.yml)
NGINX_PORT=8088

S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=rtk_eduflow_minio
S3_SECRET_KEY=rtk_eduflow_minio_secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_WORKFLOW_FILES=workflow-files
S3_BUCKET_IMPORTS=imports
S3_BUCKET_REPORTS=reports
S3_BUCKET_DOCUMENTATION=documentation
S3_BUCKET_ORGANIZATION_LOGOS=organization-logos
ORGANIZATION_LOGO_PRELOAD_DIR=/preload_data/organization_logo
FILE_RETENTION_DAYS=30
FILE_MAX_UPLOAD_BYTES=26214400

REDIS_URL=redis://redis:6379/0
REPORT_QUEUE_NAME=reports
REPORT_FILE_RETENTION_DAYS=90

# Backup (scheduler starts with the default Docker Compose mode)
BACKUP_LOCAL_PATH=./data/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_HEARTBEAT_INTERVAL_SECONDS=60
BACKUP_HEARTBEAT_TTL_SECONDS=180
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=

# Security (generate distinct 32-byte base64 key and a random HMAC pepper for non-demo use)
ANTIVIRUS_ENABLED=True
ANTIVIRUS_HOST=clamav
ANTIVIRUS_PORT=3310
PII_ENCRYPTION_ENABLED=false
PII_ENCRYPTION_KEY=
PII_HMAC_PEPPER=dev-only-replace-before-production

# LMS two-way demo / stub (enable only with docker compose --profile mock-lms)
LMS_MOCK_ENABLED=false
LMS_BASE_URL=http://mock-lms:8080
LMS_SERVICE_TOKEN=demo-lms-service-token-change-me
MOCK_LMS_PORT=8090
