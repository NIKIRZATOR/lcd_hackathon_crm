APP_NAME=edu_crm
APP_ENV=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://rtk_eduflow:rtk_eduflow@localhost:5432/rtk_eduflow
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=rtk-eduflow
KEYCLOAK_FRONTEND_CLIENT_ID=rtk-eduflow-frontend
KEYCLOAK_BACKEND_CLIENT_ID=rtk-eduflow-backend
KEYCLOAK_AUDIENCE=rtk-eduflow-backend

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rtk_eduflow_minio
S3_SECRET_KEY=rtk_eduflow_minio_secret
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_WORKFLOW_FILES=workflow-files
S3_BUCKET_IMPORTS=imports
S3_BUCKET_REPORTS=reports
S3_BUCKET_DOCUMENTATION=documentation
FILE_RETENTION_DAYS=30
FILE_MAX_UPLOAD_BYTES=26214400

REDIS_URL=redis://localhost:6379/0
REPORT_QUEUE_NAME=reports
REPORT_FILE_RETENTION_DAYS=90
